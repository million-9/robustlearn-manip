Panels:
  - Class: rviz_common/Displays
    Name: Displays

Visualization Manager:
  Class: ""
  Name: root
  Enabled: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48

  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Plane: XY

    - Class: rviz_default_plugins/RobotModel
      Name: Panda Robot
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false

    - Class: rviz_default_plugins/MarkerArray
      Name: Peg-Tip Alignment
      Enabled: true
      Marker Topic:
        Value: /robustlearn/cartesian_alignment_markers
      Namespaces:
        robustlearn_insertion: true
      Queue Size: 10
