<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robustlearn_mujoco_hardware</name>
  <version>0.0.0</version>
  <description>MuJoCo-backed ros2_control hardware plugin for RobustLearn-Manip.</description>
  <maintainer email="mhd.musthafa.de@gmail.com">mohamed-musthafa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>
  <test_depend>boost</test_depend>
  <test_depend>moveit_core</test_depend>
  <test_depend>moveit_resources_panda_description</test_depend>
  <test_depend>moveit_resources_panda_moveit_config</test_depend>
  <test_depend>srdfdom</test_depend>
  <test_depend>urdf</test_depend>

  <!--
    MuJoCo itself is an external non-ROS dependency. The CMake configuration
    locates the C/C++ headers and shared library from ROBUSTLEARN_MUJOCO_ROOT
    or from an importable Python mujoco installation.
  -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
