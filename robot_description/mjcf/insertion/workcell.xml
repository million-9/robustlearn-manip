      <geom
        name="fixture_front_collision"
        type="box"
        pos="0 -0.05475 0"
        size="0.0095 0.04525 0.03"
        group="3"
      />

      <!-- Rear wall -->

      <geom
        name="fixture_rear_visual"
        type="box"
        pos="0 0.05475 0"
        size="0.0095 0.04525 0.03"
        material="fixture_material"
        contype="0"
        conaffinity="0"
        group="2"
      />

      <geom
        name="fixture_rear_collision"
        type="box"
        pos="0 0.05475 0"
        size="0.0095 0.04525 0.03"
        group="3"
      />

      <body
        name="receptacle"
        pos="0 0 0.03"
