<mujoco model="robustlearn panda insertion task">
  <option integrator="implicitfast"/>

  <asset>
    <!--
      The Panda model remains vendored and unmodified. This project-owned
      entry point composes it with RobustLearn insertion-task assets.
    -->
    <model
      name="panda"
      file="../franka_emika_panda/panda.xml"
    />

    <model
      name="workcell"
      file="workcell.xml"
    />

    <!--
      The hardware plugin attaches this model's tool_mount frame to the
      Panda hand through the MuJoCo mjSpec API before compilation.
    -->
    <model
      name="fixed_peg"
      file="fixed_peg.xml"
    />
  </asset>

  <worldbody>
    <attach
      model="panda"
      prefix=""
    />

    <attach
      model="workcell"
      frame="workcell_root"
      prefix=""
    />
  </worldbody>

  <keyframe>
    <!--
      Week 9 global-approach start. The seven arm values reuse the
      collision-free target already exercised by the Week 8 MoveIt
      execution acceptance path. Finger and gripper controls match the
      vendored Panda home keyframe.
    -->
    <key
      name="week9_approach"
      qpos="0.10 -0.10 0.10 -1.70 0.10 1.70 -0.70 0.04 0.04"
      ctrl="0.10 -0.10 0.10 -1.70 0.10 1.70 -0.70 255"
    />

    <!--
      Week 9 clean acceptance scenario matrix.

      These configurations deliberately stay close to the validated
      week9_approach configuration. They introduce small deterministic
      joint-space variations without sensor noise, model randomization,
      or domain randomization.

      Each case is used as a distinct global MoveIt approach start.
    -->
    <key
      name="week9_case_01"
      qpos="0.10 -0.10 0.10 -1.70 0.10 1.70 -0.70 0.04 0.04"
      ctrl="0.10 -0.10 0.10 -1.70 0.10 1.70 -0.70 255"
    />

    <key
      name="week9_case_02"
      qpos="0.08 -0.10 0.10 -1.70 0.10 1.70 -0.70 0.04 0.04"
      ctrl="0.08 -0.10 0.10 -1.70 0.10 1.70 -0.70 255"
